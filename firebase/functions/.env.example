# Server-side only — copy to firebase/functions/.env for emulator, or set as
# Cloud Functions secrets / runtime env (never EXPO_PUBLIC_*, never commit real values).
# See docs/MULTI-IA-PROXY.md

# --- Required for each engine you want LIVE ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=   # alias accepted for Gemini
XAI_API_KEY=
# GROK_API_KEY=        # alias accepted for Grok
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# --- Optional model overrides ---
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.0-flash
# XAI_MODEL=grok-2-latest
# MISTRAL_MODEL=mistral-small-latest
# DEEPSEEK_MODEL=deepseek-chat

# --- Optional CORS (default *) ---
# MULTI_IA_CORS_ORIGIN=*

# --- Spend guards (defaults shown) ---
# MULTI_IA_RATE_LIMIT_MAX=30
# MULTI_IA_RATE_LIMIT_WINDOW_MS=60000
# MULTI_IA_DAILY_MAX=200
# MULTI_IA_REQUIRE_APP_CHECK=0
