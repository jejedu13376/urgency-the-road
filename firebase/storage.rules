rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function isVideo() {
      return request.resource != null
        && request.resource.contentType.matches('video/.*')
        && request.resource.size < 80 * 1024 * 1024;
    }

    /**
     * Module 12 — Fil mécanique CDN.
     * Owner write under feedVideos/{uid}/… ; signed-in read for feed playback.
     * Deny everything else (no world-open bucket).
     */
    match /feedVideos/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) && isVideo();
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
