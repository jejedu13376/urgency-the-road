# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native / signing / Firebase credentials — never commit
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
google-services.json
GoogleService-Info.plist
serviceAccount*.json
**/serviceAccount*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# local env files / secret dumps — never commit real keys
.env
.env.*
**/.env
**/.env.*
.env*.local
ENV-YOUTUBE.env
docs/ENV-YOUTUBE.env
**/ENV-YOUTUBE.env
*SECRET*.env
**/*SECRET*.env
*.env.*SECRET*
.env.secret*
**/secrets.env
!.env.example
!**/.env.example

# Firebase Functions build output
firebase/functions/lib/
firebase/functions/node_modules/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# ngrok helper (restart-ngrok.sh)
.ngrok-tunnel.log
.ngrok-tunnel.pid
.ngrok-exp-url.txt
.ngrok-https-url.txt

