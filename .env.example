# Copy to .env (gitignored). Placeholders only — Lorenzo pastes real values locally.
# EXPO_PUBLIC_* are embedded in the client bundle — never put private server secrets here.
# After editing .env: restart Expo with cache clear → npx expo start -c

# --- Firebase Auth + Firestore (Module 15 + all services) ---
# From Firebase Console → Project settings → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional seller-demo startup gate (embedded in client bundle — light friction only).
# Leave unset to disable the gate. Never commit a real shared password in source.
# If a plaintext gate password was previously committed, rotate it.
# EXPO_PUBLIC_APP_GATE_PASSWORD=

# DEV soft-auth: soft-fail Firestore permission / rescuer KYC gates → mock (Expo loads).
# Also on automatically when __DEV__ is true. Unset / false for production builds.
# EXPO_PUBLIC_DEV_SOFT_AUTH=1

# --- YouTube Data API v3 (Modules 6 / 11) ---
# Paste into root `.env` only (gitignored). Do not put keys in docs/ENV-YOUTUBE.env.
# Restrict the key in Google Cloud (HTTP referrer / app + YouTube Data API v3 only).
EXPO_PUBLIC_YOUTUBE_API_KEY=

# --- Payments (Module 15) — Stripe · PayPal · Apple Pay · Google Pay (no Lydia) ---
EXPO_PUBLIC_STRIPE_CHECKOUT_BASE=
EXPO_PUBLIC_PAYPAL_CHECKOUT_BASE=
EXPO_PUBLIC_REVENUECAT_API_KEY=

# --- Multi-IA (Module 6) — LIVE votes via SERVER PROXY only ---
# Never put OpenAI/Anthropic/Gemini/Grok/Mistral/DeepSeek keys in EXPO_PUBLIC_*:
# they ship in the JS bundle and can be extracted. Keep provider keys on the proxy
# (firebase/functions — see docs/MULTI-IA-PROXY.md). Client sends Firebase ID token.
# After `firebase deploy --only functions:multiIa`, paste the HTTPS URL here:
# EXPO_PUBLIC_MULTI_IA_PROXY_URL=https://us-central1-<PROJECT_ID>.cloudfunctions.net/multiIa

# --- Install / share link (Module 16) ---
# When unset, partage refuses to share a link (no fake store listing).
# EXPO_PUBLIC_INSTALL_URL=https://your-store-or-pwa.example/install

# --- Google Places Autocomplete (Module 7 GPS search bar) ---
# Create a restricted key in Google Cloud Console (billing must be on):
#   APIs & Services → enable "Places API (New)" → Credentials → API key
# Restrict by app package / bundle / HTTP referrer + Places API only.
# Paste into root `.env` (gitignored) AND Cursor Dashboard → Cloud Agents → Secrets
# under the same name. `cursor-cloud-bind-app-secrets` cannot bind EXPO_PUBLIC_*
# (reserved) — Dashboard secrets / local `.env` only. Never commit a real value.
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
#
# VIN = free NHTSA vPIC (no key). Recalls = free NHTSA. Weather = Open-Meteo (no key).
# Fallback geocode (no Places key) = Open-Meteo → Photon. Garages / weigh = Overpass OSM.
# OBD BLE = Dev Client + react-native-ble-plx.
