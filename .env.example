# Copy to .env (gitignored via .env*.local pattern — also add .env to .gitignore).
# EXPO_PUBLIC_* values are embedded in the client bundle — never put private keys here.
# Create a Firebase Web app and paste the config from Project settings → Your apps.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional override for startup gate (otherwise local app constant is used)
# EXPO_PUBLIC_APP_GATE_PASSWORD=
