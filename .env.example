# Copy to .env (gitignored). Placeholders only — Lorenzo pastes real values locally.
# EXPO_PUBLIC_* are embedded in the client bundle — never put private server secrets here.
# After editing .env: restart Expo with cache clear → npx expo start -c

# --- Firebase Auth + Firestore (Module 15 + all services) ---
# From Firebase Console → Project settings → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional startup gate override
# EXPO_PUBLIC_APP_GATE_PASSWORD=

# --- YouTube Data API v3 (Modules 6 / 11) ---
# Same key name as docs/ENV-YOUTUBE.env — paste into .env (or copy that file).
# Restrict the key in Google Cloud (HTTP referrer / app + YouTube Data API v3 only).
EXPO_PUBLIC_YOUTUBE_API_KEY=

# --- Payments (Module 15) — Stripe · PayPal · Apple Pay · Google Pay (no Lydia) ---
EXPO_PUBLIC_STRIPE_CHECKOUT_BASE=
EXPO_PUBLIC_PAYPAL_CHECKOUT_BASE=
EXPO_PUBLIC_REVENUECAT_API_KEY=

# VIN = free NHTSA vPIC (no key). OBD BLE = Dev Client + react-native-ble-plx.
